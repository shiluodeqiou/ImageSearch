<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <AssemblyName>以图搜图</AssemblyName>
    <RootNamespace>以图搜图</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- 发行版标识：4.1b 为自定义版本号（基于上游 4.0 + 选择性移植 4.1 的检索优化） -->
    <Version>4.1.0</Version>
    <InformationalVersion>4.1b</InformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="logo.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Masuit.Tools.Abstractions" Version="2026.2.2" />
    <PackageReference Include="Scalar.AspNetCore.Swashbuckle" Version="2.17.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="config.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Everything64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    内置 ffmpeg：视频抽帧用。
    复制到输出目录的 tools\ 下，FfmpegLocator 会自动在此查找。
    说明：这是 LGPL v3 构建（可随本程序分发），仅用于解码与抽帧，
          不涉及再编码，符合 LGPL 的使用条件；许可全文见 tools\ffmpeg-LICENSE.txt。
    体积约 127MB——若不希望内置，删除本 ItemGroup 与 tools 目录即可，
          此时视频抽帧会自动退回系统缩略图方案（功能仍可用）。
  -->
  <ItemGroup Condition="Exists('tools\ffmpeg.exe')">
    <None Include="tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\ffmpeg.exe</Link>
    </None>
    <None Include="tools\ffmpeg-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\ffmpeg-LICENSE.txt</Link>
    </None>
  </ItemGroup>
</Project>
